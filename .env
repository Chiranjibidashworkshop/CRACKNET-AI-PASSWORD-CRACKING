# CrackNet Environment Variables

# Flask Configuration
FLASK_APP=src/app/app.py
FLASK_ENV=development
FLASK_DEBUG=1

# Server Configuration
HOST=0.0.0.0
PORT=5000

# HIBP API (Have I Been Pwned)
# Get your API key from: https://haveibeenpwned.com/API/Key
HIBP_API_KEY=your_hibp_api_key_here

# Model Configuration
MODEL_PATH=models/password_model.pkl
ENCODER_PATH=models/label_encoder.pkl

# Dataset Configuration
DATASET_PATH=data/raw/rockyou.txt
PROCESSED_DATA_PATH=data/processed/cleaned_passwords.csv
